# Client-side (safe to expose, injected at build time by Vite)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Server-side secrets are NOT stored here.
# Backend (edge function) secrets live in the Lovable Cloud backend secret store:
#   LOVABLE_API_KEY  - AI gateway key used by the echoless-chat function
#   RESEND_API_KEY   - transactional email sending
